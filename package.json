{
  "name": "lifebots",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "LifeBots — jogo 2D, PWA e base de integração Supabase",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:edge": "node --experimental-strip-types --test supabase/tests/*.test.mjs",
    "test:mobile": "node --test tests/mobile-layout.mjs",
    "check": "node scripts/check.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "mobile:android": "npm run build && npx cap sync android",
    "mobile:ios": "npm run build && npx cap sync ios",
    "simulate:chat": "node scripts/simulate-chat.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
