# Local template only. Never commit .env or replace these with live values in Git.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DAILY_JOB_SECRET=replace-with-at-least-32-random-characters
# Supabase URL / anon / service role are auto-provisioned by Supabase CLI/cloud.
# Configure these only in Supabase Secrets when validating the gateway.
